# Copy to .env and fill in. Keep comments on their own lines: python-dotenv
# keeps a comment written after an EMPTY value as the value itself.

# openai_compat | google_genai
LLM_PROVIDER=
# the course key is a Polza key; your own key of any channel goes here too
LLM_API_KEY=
# the course channel. Others: DeepSeek https://api.deepseek.com, Cerebras https://api.cerebras.ai/v1
# google_genai: session 1 reads this too, https://generativelanguage.googleapis.com/v1beta/openai/
LLM_BASE_URL=
# empty for Polza, Gemini and Cerebras; none for DeepSeek direct and gpt-5.x
LLM_REASONING_EFFORT=

# Polza ignores reasoning_effort in the request: the switch rides in the model id
MODEL_CHEAP=
MODEL_STRONG=

# from session 2; leave the three empty before that
LANGFUSE_HOST=http://localhost:3000
# pk-lf-... invent it; compose creates the project with it
LANGFUSE_PUBLIC_KEY=
# sk-lf-... same
LANGFUSE_SECRET_KEY=
LANGFUSE_USER_EMAIL=
LANGFUSE_USER_PASSWORD=
